  <p style="font-size:14px;color:var(--text);line-height:1.7;margin-bottom:20px">${concept.summary}</p>
  <div style="background:var(--cream);border-radius:var(--r);padding:16px 18px;margin-bottom:16px">
    <div style="font-size:10px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Examples</div>
    ${concept.examples.map(([es,en])=>`<div style="margin-bottom:10px"><div style="font-family:'Playfair Display',serif;font-size:16px;color:var(--navy);margin-bottom:2px">${es}</div>${en?`<div style="font-size:12px;color:var(--muted);font-style:italic">${en}</div>`:''}</div>`).join('')}
  </div>
  ${concept.tip?`<div style="background:var(--grammar-light);border-left:3px solid var(--grammar-accent);border-radius:var(--rs);padding:12px 14px;margin-bottom:24px;font-size:13px;color:var(--navy);line-height:1.6"><strong style="color:var(--grammar-accent)">Tip:</strong> ${concept.tip}</div>`:''}
  <button class="primary-btn" id="start-practice-btn"><span class="gold-bar"></span>Start practicing</button>
  <button class="secondary-btn" id="skip-concept-btn" style="margin-top:8px">I already know this — skip</button></div>`;
}
 
function readingHTML(){
  const p=S.readingPassage;if(!p){S.screen='home';render();return'';}
  if(S.readingQ>=p.questions.length)return readingResultHTML(p);
  const q=p.questions[S.readingQ];const pct=Math.round((S.readingQ/p.questions.length)*100);
  return`${hdr('home')}<div class="activity-header"><div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div><span class="strip-info">${p.icon} ${p.type}</span><span class="strip-score">${S.readingScore}&#10003; ${S.readingQ+1}/${p.questions.length}</span></div>
  <div class="main"><div class="activity-type-badge" style="background:#EBF3FC;color:#1B6BB5">&#128196; Reading Comprehension</div>
  <div style="font-size:13px;color:var(--muted);font-style:italic;margin-bottom:8px"><strong style="color:var(--navy);font-style:normal">Context:</strong> ${p.contextEng}</div>
  <div style="background:var(--cream);border:1px solid #D8E8F0;border-left:3px solid #1B6BB5;border-radius:var(--rs);padding:14px 16px;margin-bottom:18px;font-family:monospace;font-size:13px;color:var(--navy);line-height:1.7;white-space:pre-wrap;overflow-x:auto">${p.text}</div>
  <div class="q-text" style="font-size:16px">${q.q}</div>
  <div class="options-grid">${q.opts.map((opt,i)=>{let cls='';if(S.readingAnswered){if(i===q.ans)cls='correct';else if(i===S.readingChosen&&i!==q.ans)cls='wrong';}return`<button class="option ${cls}" data-ropt="${i}" ${S.readingAnswered?'disabled':''}><span class="opt-letter">${L[i]}</span>${opt}</button>`;}).join('')}</div>
  ${S.readingAnswered?`<div class="feedback ${S.readingChosen===q.ans?'correct-fb':'wrong-fb'}"><strong>${S.readingChosen===q.ans?'Correcto!':'Not quite.'}</strong>${S.readingChosen!==q.ans?` The answer is <strong>${q.opts[q.ans]}</strong>.`:''}<br><span style="margin-top:4px;display:block">${q.exp}</span></div><button class="next-btn" id="reading-next">${S.readingQ<p.questions.length-1?'Next question':'Ver resultados'}</button>`:''}
  </div>`;
}
function readingResultHTML(p){const pct=Math.round((S.readingScore/p.questions.length)*100);const msg=pct>=80?'Excelente!':pct>=60?'Buen trabajo!':'Sigue practicando!';const color=pct>=80?'var(--correct)':pct>=60?'var(--gold)':'var(--wrong)';
return`${hdr('home')}<div class="result-header"><div class="result-score">${pct}<span>%</span></div><div class="result-msg">${msg} ${p.icon} ${p.type}</div></div>
<div class="main"><div class="stat-row"><div class="stat-cell"><div class="stat-val" style="color:var(--correct)">${S.readingScore}</div><div class="stat-lbl">Correct</div></div><div class="stat-cell"><div class="stat-val" style="color:var(--wrong)">${p.questions.length-S.readingScore}</div><div class="stat-lbl">Incorrect</div></div><div class="stat-cell"><div class="stat-val" style="color:${color}">${pct}%</div><div class="stat-lbl">Score</div></div></div>
<button class="primary-btn" id="reading-retry"><span class="gold-bar"></span>Read again</button><button class="secondary-btn" id="home-btn" style="margin-top:8px">Choose a different topic</button></div>`;}
 
function settingsHTML(){
  const voices=getSpanishVoices();const savedVoice=localStorage.getItem('nsa_voice')||'';const savedRate=getSavedRate();
  return`${hdr('settings')}<div class="main"><div class="intro" style="margin-bottom:18px"><h2>Voice Settings</h2><p>Choose the Spanish voice that sounds most natural on your device.</p></div>
  ${voices.length===0?`<div style="background:#FEF3E2;border:1px solid #B35A00;border-radius:var(--rs);padding:14px;font-size:13px;color:#B35A00">No Spanish voices found. Try Chrome or install a Spanish language pack.</div>`:
  `<div class="section-label">Spanish voices (${voices.length} found)</div>${voices.map(v=>{const isSel=savedVoice?v.name===savedVoice:v===getSavedVoice();const country=v.lang.split('-')[1]||'';const flag={ES:'&#127466;&#127480;',MX:'&#127474;&#127485;',US:'&#127482;&#127480;',AR:'&#127462;&#127479;',CO:'&#127464;&#127476;'}[country]||'&#127758;';return`<div class="voice-card${isSel?' selected':''}" data-voice="${v.name}" data-preview="Hola, me llamo ${v.name.split(' ')[0]}. Vamos a practicar espanol."><span style="font-size:20px">${flag}</span><div style="flex:1"><div style="font-size:13px;font-weight:500;color:var(--navy)">${v.name}${isSel?' &#10003;':''}</div><div style="font-size:11px;color:var(--muted)">${v.lang}${v.localService?' on device':' online'}</div></div><span style="font-size:11px;padding:3px 8px;border-radius:10px;background:${isSel?'var(--gold)':'var(--cream-dark)'};color:${isSel?'#fff':'var(--muted)'};">${isSel?'Selected':'Tap to try'}</span></div>`;}).join('')}
  <div class="section-label" style="margin-top:18px">Speaking speed</div><div style="background:var(--cream);border-radius:var(--rs);padding:16px"><input id="rate-slider" type="range" min="0.6" max="1.15" step="0.05" value="${savedRate}" style="width:100%;accent-color:var(--gold);margin-bottom:8px"><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted)"><span>Slow</span><span>Normal</span><span>Fast</span></div><div style="text-align:center;margin-top:10px"><button onclick="speak('Buenos dias. Como estas? Vamos a practicar espanol.')" style="padding:8px 18px;background:var(--navy);color:#fff;border:none;border-radius:var(--rs);font-family:inherit;font-size:13px;cursor:pointer">&#128266; Test</button></div></div>`}
  </div>`;
}
 
function bind(){
  document.getElementById('nav-home')?.addEventListener('click',()=>{S.screen='home';render();});
  document.getElementById('nav-prog')?.addEventListener('click',()=>{S.screen='progress';render();});
  document.getElementById('nav-set')?.addEventListener('click',()=>{S.screen='settings';render();});
  document.querySelectorAll('[data-topic]').forEach(c=>c.addEventListener('click',()=>{
    const mode=c.dataset.mode,topicId=c.dataset.topic;
    if(mode==='grammar'){S.topicId=topicId;S.mode=mode;S.screen='concept';render();}
    else if(mode==='reading'){S.topicId=topicId;S.mode='reading';S.screen='reading';S.readingPassage=READING_PASSAGES.find(p=>p.id===topicId);S.readingQ=0;S.readingScore=0;S.readingAnswered=false;S.readingChosen=null;render();}
    else{startSession(topicId,mode);}
  }));
  document.getElementById('start-practice-btn')?.addEventListener('click',()=>startSession(S.topicId,S.mode));
  document.getElementById('skip-concept-btn')?.addEventListener('click',()=>startSession(S.topicId,S.mode));
  document.querySelectorAll('[data-opt]').forEach(b=>b.addEventListener('click',()=>answerMC(+b.dataset.opt)));
  document.getElementById('audio-btn')?.addEventListener('click',function(){speak(this.dataset.speak);});
  const fi=document.getElementById('fill-input');if(fi){fi.addEventListener('input',e=>{S.fillValue=e.target.value;});fi.addEventListener('keydown',e=>{if(e.key==='Enter')submitFill();});}
  document.getElementById('fill-submit')?.addEventListener('click',submitFill);
  document.querySelectorAll('[data-left]').forEach(c=>c.addEventListener('click',()=>{const act=S.activities[S.current];const i=+c.dataset.left;const word=act.listenMode?c.dataset.speak:act.pairs[i][0];if(word)speak(word);if(act.listenMode)act._heard[i]=true;matchSelectLeft(i);}));
  document.querySelectorAll('[data-right]').forEach(c=>c.addEventListener('click',()=>matchSelectRight(+c.dataset.right)));
  document.getElementById('next-btn')?.addEventListener('click',nextActivity);
  document.getElementById('retry-btn')?.addEventListener('click',()=>startSession(S.topicId,S.mode));
  document.getElementById('home-btn')?.addEventListener('click',()=>{S.screen='home';render();});
  document.querySelectorAll('[data-ropt]').forEach(b=>b.addEventListener('click',()=>{if(S.readingAnswered)return;const i=+b.dataset.ropt;const p=S.readingPassage;const q=p.questions[S.readingQ];S.readingAnswered=true;S.readingChosen=i;if(i===q.ans){S.readingScore++;recordAnswer('r2_'+p.id,q.q,true,S.sessionDate);}else recordAnswer('r2_'+p.id,q.q,false,S.sessionDate);render();}));
  document.getElementById('reading-next')?.addEventListener('click',()=>{S.readingQ++;S.readingAnswered=false;S.readingChosen=null;render();});
  document.getElementById('reading-retry')?.addEventListener('click',()=>{S.readingQ=0;S.readingScore=0;S.readingAnswered=false;S.readingChosen=null;render();});
  document.getElementById('clear-btn')?.addEventListener('click',()=>{if(confirm('Reset all Level 2 progress?')){localStorage.removeItem('nsa2_mastery');render();}});
  document.querySelectorAll('[data-voice]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('nsa_voice',b.dataset.voice);speak(b.dataset.preview||'hola');render();}));
  document.getElementById('rate-slider')?.addEventListener('input',e=>localStorage.setItem('nsa_rate',e.target.value));
}
 
function startSession(topicId,mode){
  S.topicId=topicId;S.mode=mode;
  S.activities=mode==='grammar'?buildGrammarSession(GRAMMAR_TOPICS.find(t=>t.id===topicId)):buildVocabSession(VOCAB_TOPICS.find(t=>t.id===topicId));
  S.current=0;S.sessionCorrect=0;S.sessionDate=todayStr();S.answered=false;S.chosen=null;S.fillValue='';S.matchLeft=null;S.matchRight=null;S.matchedPairs=[];S.wrongFlash=null;
  S.screen='session';render();
  const act=S.activities[0];
  if(act.type==='audio-to-word')setTimeout(()=>speak(act.word),400);
  if(act.type==='matching'&&act.listenMode)setTimeout(()=>{speak(act.pairs[0][0]);act._heard[0]=true;render();},400);
}
function answerMC(i){if(S.answered)return;const act=S.activities[S.current];S.answered=true;S.chosen=i;const ok=i===act.correct;if(ok)S.sessionCorrect++;recordAnswer(S.topicId,act.word,ok,S.sessionDate);render();}
function submitFill(){if(S.answered)return;const act=S.activities[S.current];S.answered=true;const ok=S.fillValue.trim().toLowerCase()===act.answer.toLowerCase();if(ok)S.sessionCorrect++;recordAnswer(S.topicId,act.word,ok,S.sessionDate);render();}
function matchSelectLeft(i){const act=S.activities[S.current];if(S.matchedPairs.some(mp=>mp[0]===i))return;S.matchLeft=i;S.wrongFlash=null;if(S.matchRight!==null)tryMatch(act);else render();}
function matchSelectRight(i){const act=S.activities[S.current];if(S.matchedPairs.some(mp=>mp[1]===i))return;S.matchRight=i;S.wrongFlash=null;if(S.matchLeft!==null)tryMatch(act);else render();}
function tryMatch(act){const li=S.matchLeft,ri=S.matchRight;const lw=act.pairs[li][0];const rw=act._rw[ri];const ok=act.pairs.find(p=>p[0]===lw&&p[1]===rw);if(ok){S.matchedPairs.push([li,ri]);recordAnswer(S.topicId,lw,true,S.sessionDate);if(S.matchedPairs.length===act.pairs.length)S.sessionCorrect++;}else{recordAnswer(S.topicId,lw,false,S.sessionDate);S.wrongFlash='L'+li;setTimeout(()=>{S.wrongFlash=null;S.matchLeft=null;S.matchRight=null;render();},700);}S.matchLeft=null;S.matchRight=null;render();}
function nextActivity(){if(S.current<S.activities.length-1){S.current++;S.answered=false;S.chosen=null;S.fillValue='';S.matchLeft=null;S.matchRight=null;S.matchedPairs=[];S.wrongFlash=null;render();const act=S.activities[S.current];if(act.type==='audio-to-word')setTimeout(()=>speak(act.word),400);if(act.type==='matching'&&act.listenMode)setTimeout(()=>{speak(act.pairs[0][0]);act._heard[0]=true;render();},400);}else{S.screen='result';render();}}
 
render();
</script>
</body>
</html>
 
