function loadMastery(){try{return JSON.parse(localStorage.getItem('nsa2_mastery')||'{}');}catch{return{};}}
function saveMastery(m){try{localStorage.setItem('nsa2_mastery',JSON.stringify(m));}catch{}}
function getWordStatus(topicId,word){const m=loadMastery();const d=m[topicId]?.[word];if(!d||d.correct===0)return'new';const u=new Set(d.sessions||[]).size;if(d.correct>=3&&u>=2)return'mastered';if(d.correct>=3)return'familiar';return'learning';}
function recordAnswer(topicId,word,correct,sessionDate){const m=loadMastery();if(!m[topicId])m[topicId]={};if(!m[topicId][word])m[topicId][word]={correct:0,wrong:0,sessions:[]};if(correct){m[topicId][word].correct++;if(!m[topicId][word].sessions.includes(sessionDate))m[topicId][word].sessions.push(sessionDate);}else m[topicId][word].wrong=(m[topicId][word].wrong||0)+1;saveMastery(m);}
function getTopicStats(topicId,keys){const c={new:0,learning:0,familiar:0,mastered:0};keys.forEach(k=>c[getWordStatus(topicId,k)]++);return c;}
function getTopicBadge(topicId,keys){const s=getTopicStats(topicId,keys),t=keys.length;if(s.mastered===t)return{label:'Mastered',cls:'badge-mastered'};if(s.mastered>0||s.familiar>0)return{label:'In progress',cls:'badge-learning'};return{label:'New',cls:'badge-new'};}
 
const ACT=['multiple-choice','audio-to-word','matching','listen-match','fill-blank','multiple-choice'];
function shuffle(arr){return[...arr].sort(()=>Math.random()-.5);}
function todayStr(){return new Date().toISOString().split('T')[0];}
 
function pickWords(topic,n=6){const g={new:[],learning:[],familiar:[],mastered:[]};topic.words.forEach(w=>g[getWordStatus(topic.id,w[0])].push(w));return[...g.new,...g.learning,...g.familiar,...g.mastered].slice(0,n);}
function buildVocabSession(topic){const words=pickWords(topic,Math.min(topic.words.length,8));return words.map((word,i)=>buildActivity(ACT[i%ACT.length],word,topic));}
function buildActivity(type,word,topic){
  const[sp,en]=word;const dist=topic.words.filter(w=>w[0]!==sp).sort(()=>Math.random()-.5).slice(0,3);
  if(type==='multiple-choice'){const opts=shuffle([en,...dist.map(d=>d[1])]);return{type,word:sp,answer:en,question:`What does "${sp}" mean?`,options:opts,correct:opts.indexOf(en),actLabel:'Multiple Choice'};}
  if(type==='audio-to-word'){const opts=shuffle([en,...dist.map(d=>d[1])]);return{type,word:sp,answer:en,question:'Listen and choose the correct meaning.',options:opts,correct:opts.indexOf(en),actLabel:'Listen & Choose'};}
  if(type==='fill-blank'){return{type,word:sp,answer:sp,question:`Translate to Spanish: "${en}"`,actLabel:'Fill in the Blank'};}
  if(type==='matching'||type==='listen-match'){const pairs=shuffle([word,...dist.slice(0,3)]).slice(0,4);return{type:'matching',listenMode:type==='listen-match',word:sp,pairs,actLabel:type==='listen-match'?'Listen & Match':'Read & Match'};}
  const opts=shuffle([en,...dist.map(d=>d[1])]);return{type:'multiple-choice',word:sp,answer:en,question:`What does "${sp}" mean?`,options:opts,correct:opts.indexOf(en),actLabel:'Multiple Choice'};
}
function buildGrammarSession(topic){const g={new:[],learning:[],familiar:[],mastered:[]};topic.questions.forEach(q=>g[getWordStatus(topic.id,q.q)].push(q));return shuffle([...g.new,...g.learning,...g.familiar,...g.mastered]).slice(0,8).map(q=>({type:'grammar-mc',word:q.q,question:q.q,options:q.opts,correct:q.ans,explanation:q.exp,actLabel:'Grammar in Action',isGrammar:true}));}
 
