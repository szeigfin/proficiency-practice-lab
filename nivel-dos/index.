<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Practica · Nivel Dos</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#1B2A4A;--navy-light:#243558;--gold:#C9973A;--gold-light:#E8B85A;--cream:#FAF8F3;--cream-dark:#F0EDE4;--text:#1B2A4A;--muted:#6B7A94;--correct:#2E7D52;--correct-bg:#EAF5EE;--wrong:#B33A3A;--wrong-bg:#FAEAEA;--new:#6B7A94;--learning:#C9973A;--familiar:#1B6BB5;--mastered:#2E7D52;--grammar-accent:#5B3A8C;--grammar-light:#EDE8F7;--r:12px;--rs:8px;}
html,body{min-height:100vh;background:#E8E4DA;font-family:'DM Sans',sans-serif;color:var(--text)}
.app{max-width:720px;margin:0 auto;min-height:100vh;background:#fff;box-shadow:0 0 60px rgba(0,0,0,.12)}
.header{background:var(--navy);padding:16px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid var(--gold)}
.header-left{display:flex;align-items:baseline;gap:10px}
.h-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:600;color:#fff}
.h-sub{font-size:11px;color:var(--gold-light);font-weight:300;letter-spacing:.08em;text-transform:uppercase}
.h-nav{display:flex;gap:5px}
.nav-btn{padding:5px 10px;border-radius:20px;border:1px solid rgba(255,255,255,.25);background:transparent;color:rgba(255,255,255,.7);font-size:11px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .15s}
.nav-btn:hover,.nav-btn.active{background:var(--gold);border-color:var(--gold);color:#fff}
.main{padding:22px 24px 40px}
.section-label{font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin:18px 0 9px}
.intro h2{font-family:'Playfair Display',serif;font-size:20px;font-weight:400;margin-bottom:6px}
.intro p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.6}
.stats-bar{background:var(--cream);border-radius:var(--r);padding:14px 16px;margin-bottom:20px;display:flex;align-items:center;gap:16px}
.stats-big{font-family:'Playfair Display',serif;font-size:30px;color:var(--navy);flex-shrink:0}
.stats-sub{font-size:11px;color:var(--muted)}
.mastery-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}
.legend-item{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--muted)}
.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.section-header{display:flex;align-items:center;gap:10px;margin:20px 0 10px}
.section-header-line{flex:1;height:.5px;background:var(--cream-dark)}
.section-header-title{font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
.section-header-title.vocab{color:var(--gold)}
.section-header-title.grammar{color:var(--grammar-accent)}
.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.topic-card{background:#fff;border:1px solid #E8E4DA;border-radius:var(--r);padding:12px 14px;cursor:pointer;transition:all .18s;position:relative;overflow:hidden}
.topic-card:hover{border-color:var(--navy);transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.07)}
.topic-card.grammar-card{border-color:#DDD8EE}
.topic-card.grammar-card:hover{border-color:var(--grammar-accent)}
.topic-icon{font-size:20px;margin-bottom:6px}
.topic-name{font-size:12px;font-weight:500;color:var(--navy);line-height:1.3}
.topic-count{font-size:11px;color:var(--muted);margin-top:2px}
.topic-mastery{display:flex;gap:2px;margin-top:8px;flex-wrap:wrap}
.mastery-pip{height:4px;flex:1;min-width:4px;border-radius:2px;background:var(--cream-dark)}
.mastery-pip.new{background:var(--new)}.mastery-pip.learning{background:var(--learning)}.mastery-pip.familiar{background:var(--familiar)}.mastery-pip.mastered{background:var(--mastered)}
.topic-badge{position:absolute;top:8px;right:8px;font-size:9px;padding:2px 6px;border-radius:10px;font-weight:500}
.badge-mastered{background:var(--correct-bg);color:var(--correct)}.badge-learning{background:#FDF8EF;color:var(--gold)}.badge-new{background:var(--cream-dark);color:var(--muted)}.badge-grammar{background:var(--grammar-light);color:var(--grammar-accent)}
.activity-header{background:var(--navy);padding:12px 24px;display:flex;align-items:center;gap:12px}
.progress-track{flex:1;height:3px;background:rgba(255,255,255,.15);border-radius:2px}
.progress-fill{height:3px;background:var(--gold);border-radius:2px;transition:width .4s}
.strip-info{font-size:11px;color:rgba(255,255,255,.6);white-space:nowrap;font-weight:300}
.strip-score{font-size:11px;color:var(--gold-light);white-space:nowrap;font-weight:500}
.activity-type-badge{display:inline-flex;align-items:center;gap:6px;background:var(--cream-dark);border-radius:20px;padding:4px 12px;font-size:11px;font-weight:500;color:var(--muted);margin-bottom:14px;text-transform:uppercase;letter-spacing:.06em}
.activity-type-badge.grammar-badge{background:var(--grammar-light);color:var(--grammar-accent)}
.q-text{font-family:'Playfair Display',serif;font-size:18px;font-weight:400;color:var(--navy);line-height:1.5;margin-bottom:18px}
.options-grid{display:grid;gap:8px}.options-grid.two-col{grid-template-columns:1fr 1fr}
.option{width:100%;text-align:left;padding:12px 16px;border:1px solid #D8D4C8;border-radius:var(--rs);background:#fff;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--navy);display:flex;align-items:center;gap:11px;transition:all .15s}
.option:hover:not(:disabled){border-color:var(--navy);background:var(--cream)}
.opt-letter{width:24px;height:24px;border-radius:50%;border:1px solid #D8D4C8;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;color:var(--muted)}
.option.correct{border-color:var(--correct);background:var(--correct-bg)}.option.correct .opt-letter{background:var(--correct);border-color:var(--correct);color:#fff}
.option.wrong{border-color:var(--wrong);background:var(--wrong-bg)}.option.wrong .opt-letter{background:var(--wrong);border-color:var(--wrong);color:#fff}
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.match-col-label{font-size:10px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;text-align:center}
.match-card{padding:11px 12px;border:1.5px solid #D8D4C8;border-radius:var(--rs);background:#fff;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--navy);text-align:center;transition:all .15s;min-height:48px;display:flex;align-items:center;justify-content:center;line-height:1.3}
.match-card:hover{border-color:var(--navy);background:var(--cream)}.match-card.selected{border-color:var(--gold);background:#FDF8EF;font-weight:500}.match-card.matched{border-color:var(--correct);background:var(--correct-bg);color:var(--correct);cursor:default}.match-card.wrong-flash{border-color:var(--wrong);background:var(--wrong-bg)}
.match-progress{text-align:center;font-size:13px;color:var(--muted);margin-bottom:12px}
.image-card{background:var(--cream);border:1px solid #E8E4DA;border-radius:var(--r);padding:24px;text-align:center;margin-bottom:16px}
.image-label{font-size:12px;color:var(--muted);margin-top:10px}
.audio-prompt{background:var(--navy);border-radius:var(--r);padding:26px 24px;text-align:center;margin-bottom:20px;cursor:pointer;transition:background .15s}
.audio-prompt:hover{background:var(--navy-light)}
.audio-icon{font-size:34px;margin-bottom:8px}.audio-word{font-family:'Playfair Display',serif;font-size:24px;color:#fff;margin-bottom:4px}.audio-hint{font-size:12px;color:rgba(255,255,255,.5)}
.feedback{background:var(--cream-dark);border-radius:var(--rs);padding:11px 14px;font-size:13px;color:var(--muted);line-height:1.6;margin-top:6px}
.feedback strong{color:var(--navy);font-weight:500}.feedback.correct-fb{background:var(--correct-bg);border-left:3px solid var(--correct)}.feedback.wrong-fb{background:var(--wrong-bg);border-left:3px solid var(--wrong)}
.next-btn{margin-top:14px;padding:11px 24px;background:var(--navy);color:#fff;border:none;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s}
.next-btn:hover{background:var(--navy-light)}
.blank-input{width:100%;padding:12px 16px;border:1.5px solid #D8D4C8;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:16px;color:var(--navy);background:#fff;margin-bottom:10px;transition:border-color .15s}
.blank-input:focus{outline:none;border-color:var(--navy)}.blank-input.correct{border-color:var(--correct);background:var(--correct-bg)}.blank-input.wrong{border-color:var(--wrong);background:var(--wrong-bg)}
.submit-btn{padding:11px 24px;background:var(--gold);color:#fff;border:none;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer}
.submit-btn:hover{background:#B8832E}
.result-header{background:var(--navy);padding:28px 24px 22px;text-align:center;border-bottom:3px solid var(--gold)}
.result-score{font-family:'Playfair Display',serif;font-size:52px;font-weight:600;color:#fff;line-height:1}.result-score span{color:var(--gold)}
.result-msg{font-size:12px;color:rgba(255,255,255,.6);margin-top:5px;font-weight:300;letter-spacing:.04em}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#D8D4C8;border:1px solid #D8D4C8;border-radius:var(--r);overflow:hidden;margin:18px 0}
.stat-cell{background:#fff;padding:14px 10px;text-align:center}
.stat-val{font-family:'Playfair Display',serif;font-size:24px;font-weight:400;color:var(--navy)}
.stat-lbl{font-size:10px;color:var(--muted);margin-top:2px;text-transform:uppercase;letter-spacing:.08em}
.primary-btn{width:100%;padding:13px;background:var(--navy);color:#fff;border:none;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;margin-bottom:8px;transition:background .15s;display:flex;align-items:center;justify-content:center;gap:8px}
.primary-btn:hover{background:var(--navy-light)}
.secondary-btn{width:100%;padding:12px;background:transparent;color:var(--navy);border:1px solid #D8D4C8;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;transition:border-color .15s}
.secondary-btn:hover{border-color:var(--navy)}
.gold-bar{display:inline-block;width:20px;height:2px;background:var(--gold);vertical-align:middle;margin-right:4px}
.voice-card{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1.5px solid #D8D4C8;border-radius:var(--rs);background:#fff;cursor:pointer;margin-bottom:7px;transition:all .15s}
.voice-card:hover{border-color:var(--navy)}.voice-card.selected{border-color:var(--gold);background:#FDF8EF}
.loading-wrap{padding:56px 24px;text-align:center;color:var(--muted)}
.loading-word{font-family:'Playfair Display',serif;font-size:32px;color:var(--navy);margin-bottom:8px;display:block;animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
</style>
</head>
