const GRAMMAR_CONCEPTS={
g2_pret_reg:{title:'Preterit — Regular Verbs',summary:'The preterit tense is used for completed past actions. Regular verbs follow predictable patterns by verb type.',examples:[['Ayer hable con mi madre.','Yesterday I spoke with my mother.'],['Comimos en ese restaurante el sabado.','We ate at that restaurant on Saturday.'],['Ella escribio una carta la semana pasada.','She wrote a letter last week.']],tip:'-AR endings: e, aste, o, amos, aron. -ER/-IR endings: i, iste, io, imos, ieron. Look for time markers: ayer, anoche, la semana pasada, el ano pasado.'},
g2_pret_irreg:{title:'Preterit — Irregular Verbs',summary:'Many common verbs are irregular in the preterit. Key ones: ir/ser (same forms!), estar, tener, hacer, decir, poner, venir, ver.',examples:[['Fui al mercado ayer.','I went to the market. (ir -> fui)'],['Ella estuvo muy contenta.','She was very happy. (estar -> estuvo)'],['Nosotros tuvimos que estudiar.','We had to study. (tener -> tuvimos)']],tip:'Key irregular stems: estuv- (estar), tuv- (tener), pus- (poner), vin- (venir), dij- (decir), hic- (hacer). IR and SER both become: fui, fuiste, fue, fuimos, fueron.'},
g2_commands:{title:'Imperative Mood (Commands)',summary:'Commands tell someone to do or not do something. The form depends on who you address (tu, usted, ustedes) and whether affirmative or negative.',examples:[['Habla mas despacio! (tu, affirmative)','Speak more slowly! -> use el/ella present form'],['No hables en clase! (tu, negative)','Do not speak in class! -> use present subjunctive'],['Hable usted con el director! (usted)','Speak with the principal! -> subjunctive form']],tip:'Affirmative tu commands: use el/ella present form (habla, come, abre). Negative tu + ALL usted/ustedes commands use present subjunctive. Irregular tu commands: di, haz, ve, ven, pon, sal, se, ten.'},
g2_future:{title:'Future Tense (Regular)',summary:'The future tense expresses what will happen. For regular verbs, add the future endings to the complete infinitive.',examples:[['Hablare con ella manana.','I will speak with her tomorrow.'],['Nosotros comeremos en casa.','We will eat at home.'],['Ellos viviran en Madrid.','They will live in Madrid.']],tip:'Future endings (same for all types): -e, -as, -a, -emos, -eis, -an. Add to the full infinitive: hablar+e=hablare, comer+as=comeras, vivir+a=vivira.'},
g2_reflex:{title:'Reflexive Verbs',summary:'Reflexive verbs indicate the subject does the action to itself. Use reflexive pronouns: me, te, se, nos, os, se — matching the subject.',examples:[['Yo me levanto a las siete.','I get up at seven.'],['Ella se llama Maria.','Her name is Maria.'],['Nosotros nos duchamos por la manana.','We shower in the morning.']],tip:'Reflexive pronouns go BEFORE the conjugated verb. Common reflexives describe daily routines: llamarse, levantarse, acostarse, ducharse, banarse, vestirse, despertarse.'},
g2_saber_conocer:{title:'Saber vs. Conocer',summary:'Both mean to know but are used differently. SABER = to know facts or how to do something. CONOCER = to know/be familiar with a person, place, or thing.',examples:[['Se hablar espanol.','I know how to speak Spanish. (skill -> SABER)'],['Conoces a mi amiga Ana?','Do you know my friend Ana? (person -> CONOCER)'],['Se que manana hay examen.','I know there is a test tomorrow. (fact -> SABER)']],tip:'SABER + infinitive = know HOW to. SABER + que = know a fact. CONOCER + person/place = be acquainted with. YO forms: se (saber) / conozco (conocer).'},
g2_mente:{title:'Adverbs with -mente',summary:'Form adverbs from adjectives by adding -mente (like -ly in English). Use the feminine form of the adjective before adding -mente.',examples:[['rapido -> rapida -> rapidamente','quickly'],['facil -> facilmente','easily (no gender change needed)'],['Ella habla lentamente.','She speaks slowly.']],tip:'Steps: 1) Find feminine form (rapido->rapida). 2) Add -mente. If adjective ends in -e or consonant, add -mente directly (frecuente->frecuentemente, facil->facilmente).'},
g2_negacion:{title:'Negation — nunca / nada / jamas',summary:'Beyond simple no, Spanish has: nunca (never), nada (nothing), nadie (nobody), jamas (never — emphatic). Double negatives are required in Spanish.',examples:[['Ella nunca come carne.','She never eats meat. (before verb — no needed)'],['No tengo nada.','I have nothing. (no before verb, nada after)'],['No lo hare jamas.','I will never do it. (jamas is emphatic)']],tip:'If negative word comes BEFORE verb: no need for no. If after verb: must use no before verb too. Jamas is stronger than nunca. Double negatives are CORRECT in Spanish.'},
g2_pero_sino:{title:'Pero vs. Sino',summary:'Both translate as but. PERO = but (general contrast). SINO = but rather (used after a negative to correct or replace).',examples:[['Me gusta el cafe, pero no lo bebo por la noche.','I like coffee, but I do not drink it at night. (contrast -> PERO)'],['No soy espanol, sino mexicano.','I am not Spanish, but rather Mexican. (correction -> SINO)'],['No quiero ir al cine sino al teatro.','I do not want movies but rather the theater.']],tip:'Quick test: Can you replace but with but rather? -> SINO. Is it just showing contrast? -> PERO. SINO always follows a negative and replaces the negated element.'},
g2_infinitivo:{title:'Pensar / Deber / Tratar de + Infinitive',summary:'Three verbs followed by an infinitive expressing intention and obligation.',examples:[['Pienso estudiar medicina.','I plan to study medicine. (intention)'],['Debes llegar a tiempo.','You should arrive on time. (obligation)'],['Trato de hablar mas despacio.','I try to speak more slowly. (attempt)']],tip:'PENSAR + inf = plan to / intend to. DEBER + inf = should / must. TRATAR DE + inf = to try to. All use infinitive directly.'},
g2_preposiciones:{title:'Compound Prepositions',summary:'Compound prepositions describe position and relationship. Formed with preposition + de, very common in Spanish.',examples:[['El libro esta encima de la mesa.','The book is on top of the table.'],['El gato esta debajo de la cama.','The cat is under the bed.'],['La farmacia esta al lado del hospital.','The pharmacy is next to the hospital.']],tip:'Key compound prepositions: encima de (above), debajo de (under), delante de (in front of), detras de (behind), al lado de (next to), antes de (before), despues de (after), lejos de (far from), cerca de (near).'},
g2_acabar:{title:'Acabar de + Infinitive',summary:'Acabar de + infinitive in present tense = something just happened very recently. The Spanish equivalent of to have just done something.',examples:[['Acabo de lavar el carro.','I just washed the car.'],['Ella acaba de llegar.','She just arrived.'],['Acabamos de comer.','We just ate.']],tip:'Always use PRESENT TENSE of acabar: acabo de, acabas de, acaba de, acabamos de, acaban de + infinitive. The action happened moments ago, not hours or days.'},
g2_genero:{title:'Gender of Nouns (-dad/-cion/-ma/-ista)',summary:'Spanish noun gender can often be predicted by the ending. Four key patterns for Level 2.',examples:[['-DAD endings -> feminine','la ciudad, la universidad, la libertad'],['-CION endings -> feminine','la cancion, la nacion, la leccion'],['-MA endings (from Greek) -> masculine','el problema, el programa, el sistema']],tip:'-DAD -> always feminine (la). -CION -> always feminine (la). -MA (Greek) -> masculine (el): el problema, el tema, el sistema, el clima. -ISTA -> el or la depending on person: el/la artista, el/la turista.'},
};
 
